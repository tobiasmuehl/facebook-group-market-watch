# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. Everything else you configure lives in watch.py.
# ─────────────────────────────────────────────────────────────────────────────


# ─── LLM backend ─────────────────────────────────────────────────────────────
# Pick ONE. It applies to every stage. Do not mix backends — two auth systems
# and two rate-limit regimes is the fastest way to break this.
#
#   openrouter   pay per token, ~$0.14 per 1000 posts, needs a card
#   claude-cli   uses your existing `claude` login, no API key, capped by your
#                subscription limits
#   codex-cli    uses your existing `codex` login, same tradeoff
#
LLM_BACKEND=openrouter

# --- if LLM_BACKEND=openrouter ---
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-flash
# Escalate to deepseek/deepseek-v4-pro if extraction is wrong on hard posts.
# It is ~5x the price. Run `watcher bench` before switching — don't guess.
# Needs vision (judging photos, not text)? Use a vision model here instead;
# DeepSeek is text-only.

# --- if LLM_BACKEND=claude-cli ---
CLAUDE_MODEL=sonnet
CLAUDE_CLASSIFIER_MODEL=haiku

# --- if LLM_BACKEND=codex-cli ---
CODEX_MODEL=
CODEX_CLASSIFIER_MODEL=


# ─── Stage 1: cheap LLM classifier (optional) ────────────────────────────────
# Off by default. A keyword gate already runs before this for free.
# Turn it on when you get >500 posts/day, or when your extraction model is
# expensive/vision. At flash prices it saves about $0.11 per 1000 posts —
# its real value is catching semantic noise keywords miss.
CLASSIFIER_ENABLED=false
# For openrouter only; CLI backends use CLAUDE_/CODEX_CLASSIFIER_MODEL above.
CLASSIFIER_MODEL=deepseek/deepseek-v4-flash


# ─── Scraping ────────────────────────────────────────────────────────────────
# Token: https://console.apify.com/account/integrations
APIFY_API_TOKEN=
# Minutes between full scrape cycles.
SCRAPE_INTERVAL_MINUTES=30
# Minimum minutes between Apify calls for the SAME group. Survives restarts,
# so a crash-loop can't burn your Apify credit.
GROUP_COOLDOWN_MINUTES=30
# Posts fetched per group per cycle. If every one comes back new, the watcher
# automatically fetches a deeper batch — you were missing posts.
POSTS_PER_CYCLE=10
DEEP_FETCH_POSTS=50


# ─── Telegram (optional) ─────────────────────────────────────────────────────
# 1. Create a bot with @BotFather, copy the token
# 2. Message your bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates
#    and read chat.id out of the response
# Leave blank to skip alerts and just browse with `watcher web`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ─── Dedup ───────────────────────────────────────────────────────────────────
# Agents repost the same item daily. Two independent checks, both on:
#   image  — same photos as an earlier post
#   text   — byte-identical text (after normalizing case/whitespace)
DEDUP_ENABLED=true
DEDUP_LOOKBACK_DAYS=45
DEDUP_MIN_SHARED_IMAGES=2
DEDUP_MIN_OVERLAP_RATIO=0.6


# ─── Misc ────────────────────────────────────────────────────────────────────
DB_PATH=data/watcher.db
DATA_RETENTION_DAYS=90
# Concurrent LLM calls. Lower this if you get 429s. Forced to 1 for CLI backends.
LLM_CONCURRENCY=4
